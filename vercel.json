{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/__clerk/(.*)", "destination": "/api/clerk/$1" },
    { "source": "/((?!api/|__clerk/).*)", "destination": "/index.html" }
  ]
}
